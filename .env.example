# Copy to .env (or set these in your hosting dashboard). Never commit real values.

# Branding
BRAND_NAME=Harbor & Horizon Travel
BRAND_SHORT=Harbor & Horizon
BRAND_EMAIL=hello@example.com
BRAND_PHONE=(555) 010-0000
BRAND_CITY=Dallas, Texas
SELLER_OF_TRAVEL=

# Server
PORT=3000
BASE_URL=http://localhost:3000
# Long random string. Required before going live.
SESSION_SECRET=

# AI research assistant (optional). Enables Claude to read free text requests
# and write the plain language summary in each research report.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Phase 2 provider integrations (adapters are stubbed until built)
DUFFEL_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
VIATOR_API_KEY=
