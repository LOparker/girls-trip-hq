<%- include('_head') %>
<div class="topline"><div><h1>Bookings</h1><div class="sub">Reservations you are completing or have completed personally with suppliers.</div></div></div>
<div class="card table-wrap"><table><tr><th>Booking</th><th>Customer</th><th>Destination</th><th>Travel</th><th>Supplier</th><th>Confirmation</th><th class="right">Quoted</th><th class="right">Final</th><th>Payment</th><th>Status</th></tr>
  <% list.forEach(function (b) { %><tr><td><a href="/admin/bookings/<%= b.id %>">#<%= b.id %></a><div class="muted small"><%= b.ref_code %></div></td><td><%= b.customer_name %></td><td><%= b.destination %></td>
    <td class="nowrap"><%= fmtDate(b.travel_start) %></td><td><%= b.supplier || '' %></td><td><%= b.confirmation_number || '' %></td><td class="right"><%= money(b.quoted_total, { empty: '' }) %></td><td class="right"><%= money(b.final_price, { empty: '' }) %></td>
    <td><%= b.payment_status %></td><td><span class="pill <%= statusClass(b.booking_status) %>"><%= b.booking_status %></span></td></tr><% }) %>
  <% if (!list.length) { %><tr><td colspan="10" class="muted">No bookings yet.</td></tr><% } %></table></div>
<%- include('_foot') %>
