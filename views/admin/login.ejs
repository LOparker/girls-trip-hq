<%- include('_head') %>
<div class="auth">
  <h1 style="font-family:'Cormorant Garamond',serif; font-size:2rem"><%= brand.shortName %></h1>
  <p class="muted">Agent dashboard sign in</p>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/admin/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= next %>">
    <div class="fr one"><div><label for="e">Email</label><input type="email" id="e" name="email" autocomplete="username" required></div></div>
    <div class="fr one"><div><label for="p">Password</label><input type="password" id="p" name="password" autocomplete="current-password" required></div></div>
    <button class="btn primary" type="submit" style="width:100%; justify-content:center">Sign in</button>
  </form>
</div>
<%- include('_foot') %>
