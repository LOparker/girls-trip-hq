<%- include('../partials/header') %>
<section class="section">
  <div class="wrap" style="max-width:560px">
    <span class="eyebrow">Booking status</span>
    <h1 style="font-size:clamp(2rem,4vw,3rem)">Check your trip status</h1>
    <p class="lead">Enter the reference number from your confirmation email and the email address you used.</p>
    <form class="form-card" method="post" action="/status" style="margin-top:24px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
      <div class="field"><label for="ref">Reference number</label><input type="text" id="ref" name="ref" placeholder="TR-XXXXXX" value="<%= q.ref || '' %>" required></div>
      <div class="field" style="margin-top:14px"><label for="em">Email</label><input type="email" id="em" name="email" value="<%= q.email || '' %>" required></div>
      <button class="btn btn-primary btn-block" style="margin-top:20px" type="submit">Find my trip</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
