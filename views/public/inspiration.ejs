<%- include('../partials/header') %>
<section class="page-hero">
  <div class="bg" style="background-image:url('https://images.unsplash.com/photo-1530789253388-582c481c54b0?auto=format&fit=crop&w=2000&q=80')"></div>
  <div class="wrap"><span class="eyebrow" style="color:#f1d7b3">Travel inspiration</span><h1>Ideas for every kind of traveler</h1><p>Not sure where to start? Here are a few of our favorite ways to travel.</p></div>
</section>
<section class="section">
  <div class="wrap">
    <% var themes = [
      { t: 'Best all-inclusive escapes', d: 'Unpack once and let every meal, drink and sunset be taken care of.', slugs: ['jamaica', 'cancun', 'dominican-republic'] },
      { t: 'Romantic getaways', d: 'Adults-only resorts, cliffside dinners and island sunsets for two.', slugs: ['turks-and-caicos', 'greece', 'bali'] },
      { t: 'Family adventures', d: 'Kids clubs, wildlife, water parks and no passport trips for little travelers.', slugs: ['costa-rica', 'hawaii', 'bahamas'] },
      { t: 'Bucket list cities', d: 'Museums, markets and the kind of food you will talk about for years.', slugs: ['paris', 'italy', 'japan'] },
      { t: 'Quick long weekends', d: 'Short flights from Texas to sand and sea for a three or four night recharge.', slugs: ['bahamas', 'puerto-rico', 'cancun'] }
    ]; var map = {}; destinations.forEach(function (d) { map[d.slug] = d; }); %>
    <% themes.forEach(function (th) { %>
    <div class="block reveal">
      <div style="display:flex; justify-content:space-between; align-items:flex-end; gap:20px; flex-wrap:wrap; margin-bottom:22px">
        <div><h2 style="margin-bottom:6px"><%= th.t %></h2><p class="muted" style="margin:0"><%= th.d %></p></div>
        <a href="/plan?vacation_style=<%= encodeURIComponent(th.t.includes('Family') ? 'Family Vacation' : th.t.includes('Romantic') ? 'Romantic Getaway' : th.t.includes('weekend') ? 'Weekend Getaway' : th.t.includes('cities') ? 'International Travel' : 'All-Inclusive') %>" class="btn btn-outline btn-sm">Plan a trip like this</a>
      </div>
      <div class="grid g3"><% th.slugs.forEach(function (s) { var d = map[s]; %>
        <a href="/destinations/<%= d.slug %>" class="card dest-card"><div class="card-img" style="aspect-ratio:4/3; background-image:url('<%= d.image.replace('w=1600', 'w=800') %>')"><div class="overlay"><h3><%= d.name %></h3><span><%= d.season.split(';')[0] %></span></div></div></a>
      <% }) %></div>
    </div>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>
